<UserControl x:Class="AnyCard.Desktop.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnyCard.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- ===================== CARD REVIEW ===================== -->
    <Border Background="White" CornerRadius="16" Padding="32"
        Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
        x:Name="CardPanel">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="20" ShadowDepth="3"/>
        </Border.Effect>

        <Grid>
            <StackPanel>
                <TextBlock x:Name="QuestionText" Text="QuestionText" FontSize="20" FontWeight="SemiBold"
                   Foreground="#111827" TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

                <TextBlock x:Name="AnswerText" Text="AnswerText" FontSize="15"
                   Foreground="#4F46E5" TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,0,0,20" Visibility="Collapsed"/>

                <Button x:Name="ShowAnswerButton" Content="Antwort zeigen" Click="ShowAnswerButton_Click"
                Height="40" Background="#EEF2FF" Foreground="#4F46E5"
                BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>

                <Button x:Name="HideAnswerButton" Content="Antwort verbergen" Click="HideAnswerButton_Click"
                Height="40" Background="#EEF2FF" Foreground="#4F46E5"
                BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Visibility="Collapsed"/>

                <StackPanel x:Name="RatingButtonsPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,16,0,0">
                    <Button x:Name="AgainButton" Content="Again" Click="AgainButton_Click"
                    Width="62" Height="36" Margin="3" Background="#FEE2E2" Foreground="#991B1B"
                    BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="HardButton" Content="Hard" Click="HardButton_Click"
                    Width="62" Height="36" Margin="3" Background="#FEF3C7" Foreground="#92400E"
                    BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="GoodButton" Content="Good" Click="GoodButton_Click"
                    Width="62" Height="36" Margin="3" Background="#D1FAE5" Foreground="#065F46"
                    BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="EasyButton" Content="Easy" Click="EasyButton_Click"
                    Width="62" Height="36" Margin="3" Background="#DBEAFE" Foreground="#1E40AF"
                    BorderThickness="0" Cursor="Hand"/>

                    <ContentControl Style="{StaticResource InfoIcon}">
                        <ContentControl.ToolTip>
                            <TextBlock Text="Again: kommt bald wieder. Hard: ca. 2 Stunden. Good: ca. 2 Tage. Easy: ca. 6 Tage. Mit jeder weiteren erfolgreichen Wiederholung verdoppelt sich der Abstand. Again setzt ihn zurück." TextWrapping="Wrap" MaxWidth="260"/>
                        </ContentControl.ToolTip>
                    </ContentControl>
                </StackPanel>
            </StackPanel>
            <Button x:Name="DeleteCardButton" Style="{StaticResource DeleteButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Click="DeleteCardButton_Click"/>
        </Grid>
    </Border>
</UserControl>
