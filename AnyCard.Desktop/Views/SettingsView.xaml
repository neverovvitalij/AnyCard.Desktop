<UserControl x:Class="AnyCard.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnyCard.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- ===================== SETTINGS PANEL ===================== -->
    <Border x:Name="SettingsPanel" Background="White" CornerRadius="16" Padding="24"
        Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="20" ShadowDepth="3"/>
        </Border.Effect>

        <StackPanel>
            <!-- Seitentitel -->
            <TextBlock Text="Einstellungen" FontSize="20" FontWeight="Bold" Foreground="#111827"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <!-- ========== Sektion: Wiederholungsintervalle ========== -->
            <TextBlock Text="Wiederholungsintervalle" FontSize="15" FontWeight="SemiBold"
                   Foreground="#111827" Margin="0,0,0,4"/>
            <TextBlock Text="Erlaubt: 1 Minute bis 30 Tage" FontSize="12" Foreground="#6B7280"
                   Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Again -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Again" Foreground="#991B1B"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="AgainValueBox" Grid.Row="0" Grid.Column="1" Height="32" Margin="0,0,8,8"/>
                <ComboBox x:Name="AgainUnitBox" Grid.Row="0" Grid.Column="2" Height="32" Margin="0,0,0,8">
                    <ComboBoxItem Content="Min"/>
                    <ComboBoxItem Content="Std"/>
                    <ComboBoxItem Content="Tage"/>
                </ComboBox>

                <!-- Hard -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hard" Foreground="#92400E"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="HardValueBox" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,0,8,8"/>
                <ComboBox x:Name="HardUnitBox" Grid.Row="1" Grid.Column="2" Height="32" Margin="0,0,0,8">
                    <ComboBoxItem Content="Min"/>
                    <ComboBoxItem Content="Std"/>
                    <ComboBoxItem Content="Tage"/>
                </ComboBox>

                <!-- Good -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Good" Foreground="#065F46"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="GoodValueBox" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,0,8,8"/>
                <ComboBox x:Name="GoodUnitBox" Grid.Row="2" Grid.Column="2" Height="32" Margin="0,0,0,8">
                    <ComboBoxItem Content="Min"/>
                    <ComboBoxItem Content="Std"/>
                    <ComboBoxItem Content="Tage"/>
                </ComboBox>

                <!-- Easy -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Easy" Foreground="#1E40AF"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="EasyValueBox" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,0,8,8"/>
                <ComboBox x:Name="EasyUnitBox" Grid.Row="3" Grid.Column="2" Height="32" Margin="0,0,0,8">
                    <ComboBoxItem Content="Min"/>
                    <ComboBoxItem Content="Std"/>
                    <ComboBoxItem Content="Tage"/>
                </ComboBox>
            </Grid>

            <!-- Meldung (Fehler / Gespeichert) -->
            <TextBlock x:Name="SettingsMessageText" TextWrapping="Wrap" HorizontalAlignment="Center"
                   Margin="0,8,0,0" Foreground="#065F46" FontWeight="SemiBold" FontSize="14" Visibility="Collapsed"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="ResetSettingsButton" Content="Standard wiederherstellen"
                    Click="ResetSettingsButton_Click"
                    Height="36" Padding="12,0" Margin="0,0,8,0" Cursor="Hand"
                    Background="#EEF2FF" Foreground="#4F46E5" BorderThickness="0"/>
                <Button x:Name="SaveSettingsButton" Content="Speichern"
                    Click="SaveSettingsButton_Click"
                    Height="36" Padding="16,0" Cursor="Hand"
                    Background="#4F46E5" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Hier später weitere Sektionen ergänzen, z. B. "Konto" -->
        </StackPanel>
    </Border>
</UserControl>
