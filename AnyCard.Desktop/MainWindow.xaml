<Window x:Class="AnyCard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnyCard.Desktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
        <TextBlock TextAlignment="Center" Margin="0,0,0,10">AnyCard Login</TextBlock>
        <TextBox Margin="0,0,0,10" x:Name="UsernameTextBox"/>
        <PasswordBox Margin="0,0,0,10" x:Name="UserPassword"/>
        <Button Margin="0,10,0,0" x:Name="LoginButton" Content="Login" Click="LoginButton_Click"/>
    </StackPanel>
</Window>
