<Window x:Class="AnyCard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnyCard.Desktop"
        mc:Ignorable="d"
        Title="AnyCard" MinHeight="730" MinWidth="900" Background="#F3F4F6">
    <Window.Resources>
        
    </Window.Resources>

    <Grid>

        <!-- ===================== TOP-LEVEL NAVIGATION ===================== -->
        <StackPanel Orientation="Vertical">
            <Button x:Name="ShowAllCardsButton" Content="Alle Karten" Click="ShowAllCardsButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0"
                Height="36" Padding="21,0" Background="#4F46E5" Foreground="White"
                BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Style="{StaticResource NavButtonStyle}"
                Visibility="Collapsed"/>

            <Button x:Name="SettingsButton" Content="Einstellungen" Click="SettingsButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0"
                Height="36" Padding="21,0" Background="#4F46E5" Foreground="White"
                BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Style="{StaticResource NavButtonStyle}"
                Visibility="Collapsed"/>

            <Button x:Name="CreateNewCardButton" Content="Neue Karte" Click="CreateNewCardButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0"
                Height="36" Padding="21,0" Background="#4F46E5" Foreground="White"
                BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Style="{StaticResource NavButtonStyle}"
                Visibility="Collapsed"/>

            <Button x:Name="BackToCardsButton" Content="← Zurück" Click="BackToCardsButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0"
                Height="36" Padding="16,0" Background="Transparent" Foreground="#4F46E5"
                BorderThickness="1" BorderBrush="#4F46E5" FontWeight="SemiBold" Cursor="Hand"
                Visibility="Collapsed" Style="{StaticResource NavButtonStyle}"/>
        </StackPanel>

        <ComboBox x:Name="CardCategoryBox" SelectionChanged="CardCategoryBox_SelectionChanged" DisplayMemberPath="Name"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,20,0"
                Width="103" Height="36" Padding="10"
                Background="White" Foreground="#111827"
                BorderBrush="#D1D5DB" BorderThickness="1"
                FontWeight="SemiBold" Cursor="Hand"
                Visibility="Collapsed"/>

        <Button x:Name="LogoutButton" Content="Logout" Click="LogoutButton_Click"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                Height="36" Padding="16,0" Background="Transparent" Foreground="#4F46E5"
                BorderThickness="1" BorderBrush="#4F46E5" FontWeight="SemiBold" Cursor="Hand"
                Visibility="Collapsed"/>

        <!-- ===================== SCREEN HOST ===================== -->
        <ContentControl x:Name="ScreenHost"/>

    </Grid>
</Window>